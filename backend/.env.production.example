# Copy to .env on the VPS (same directory as package.json) and fill in real values.
# Never commit the real .env file.

PORT=8080
NODE_ENV=production

# MySQL — matches the DB installed directly on the VPS
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=furniture_app
DB_PASS=change-me-strong-password
DB_NAME=furniture_website

# Cloudinary (image upload)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Social login
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
